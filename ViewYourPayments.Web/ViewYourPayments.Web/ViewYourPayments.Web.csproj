<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="web.release.config" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Content\cookies.css" />
    <None Remove="Content\site.min.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="BuildWebCompiler" Version="1.12.405" />
    <PackageReference Include="JWT" Version="11.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.20" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.WsFederation" Version="8.0.20" />
	<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
	<PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
	<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.23" />
	<PackageReference Include="NuGet.Protocol" Version="7.6.0" />
	<PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

  <PropertyGroup>
    <PrepareForBuildDependsOn>
      BundleMinify;
    </PrepareForBuildDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Properties\PublishProfiles\" />
    <Folder Include="public\stylesheets\" />
    <Folder Include="wwwroot\assets\fonts\" />
    <Folder Include="wwwroot\assets\images\" />
    <Folder Include="wwwroot\help\" />
    <Folder Include="wwwroot\lib\jquery\dist\" />
    <Folder Include="wwwroot\javascript\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="web.release.config" />
    <None Include="wwwroot\assets\fonts\bold-affa96571d-v2.woff" />
    <None Include="wwwroot\assets\fonts\bold-b542beb274-v2.woff2" />
    <None Include="wwwroot\assets\fonts\light-94a07e06a1-v2.woff2" />
    <None Include="wwwroot\assets\fonts\light-f591b13f7d-v2.woff" />
    <None Include="wwwroot\assets\images\favicon.ico" />
    <None Include="wwwroot\assets\images\govuk-apple-touch-icon-152x152.png" />
    <None Include="wwwroot\assets\images\govuk-apple-touch-icon-167x167.png" />
    <None Include="wwwroot\assets\images\govuk-apple-touch-icon-180x180.png" />
    <None Include="wwwroot\assets\images\govuk-apple-touch-icon.png" />
    <None Include="wwwroot\assets\images\govuk-crest-2x.png" />
    <None Include="wwwroot\assets\images\govuk-crest.png" />
    <None Include="wwwroot\assets\images\govuk-logotype-crown.png" />
    <None Include="wwwroot\assets\images\govuk-mask-icon.svg" />
    <None Include="wwwroot\assets\images\govuk-opengraph-image.png" />
    <None Include="wwwroot\stylesheets\cookies.min.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViewYourPayments.Core\ViewYourPayments.Core.csproj" />
    <ProjectReference Include="..\ViewYourPayments.Infrastructure\ViewYourPayments.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <WCFMetadata Include="Connected Services" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\images\PaymentDetail.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\PaymentSummary.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\PaymentTransactions.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\vyp - Copy.min.js">
      <DependentUpon>vyp.min.js</DependentUpon>
    </Content>
    <Content Update="wwwroot\TestData.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ProjectExtensions>
    <VisualStudio>
      <UserProperties compilerconfig_1json__JsonSchema="http://json.schemastore.org/compilerconfig" />
    </VisualStudio>
  </ProjectExtensions>

</Project>
