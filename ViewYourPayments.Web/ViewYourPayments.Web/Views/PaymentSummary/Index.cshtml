@model PaymentSummaryPageViewModel
@{
        ViewData["Title"] = "PaymentHistory";
}
@Html.AntiForgeryToken()
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl">
            Payment history
            <span class="govuk-caption-xl">A list of the funding payments you have received from the Department for Education (DfE).</span>
            <span class="govuk-caption-xl">
                <details class="govuk-details" data-module="govuk-details">
                    <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">
                            Help using this page
                        </span>
                    </summary>
                    <div class="govuk-details__text">
                        This page shows all of the payments made into your bank account from the DfE within the date range shown.
                        <p>On this page you can:</p>
                        <ul>
                            <li>View the payment date and amount.</li>
                            <li>Change the date filter to view payment records from up to 3 years ago.</li>
                            <li>View your payment details and download as .CSV or PDF files.</li>
                            <li>Go to the Filter and export transactions view where you can filter and export transactions using a custom date range.</li>
                        </ul>
                        <div>
                            For more information on how to use this service please read the <a asp-controller="Content" asp-action="PaymentHelpGuidelines" asp-fragment="payment-history-view" target="_blank" rel="external noopener noreferrer">View your payments guidance.</a>
                        </div>
                    </div>
                </details>
            </span>
        </h1>
        <p>
            <a asp-action="index" asp-controller="PaymentTransactions" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
                Filter and export transactions
                <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z"></path>
                </svg>
            </a>
        </p>


        <partial name="_paymentSummaryFilter" model="@Model.DateRange" />

    </div>
</div>
<div class="govuk-grid-row">
    @if (@Model.Result != null && @Model.Result.PaymentSummaries.Any())
        {
    <partial name="Remittance/_RemittanceTable" model="@Model.Result" />
    <div class="govuk-grid-column-full">
        @using (Html.BeginForm("Index", "PaymentSumary", FormMethod.Get))
                {
        <partial name="_Pagination" model="@Model" />
                }
    </div>

        }
        else if (Model.HasValidationError)
        {
    <div class="govuk-grid-column-full">
        <p class="govuk-error-message">@Model.ValidationMessage</p>
    </div>
        }
        else
        {
            <partial name="~/Views/Shared/_NoRecordView.cshtml" />
        }
</div>
