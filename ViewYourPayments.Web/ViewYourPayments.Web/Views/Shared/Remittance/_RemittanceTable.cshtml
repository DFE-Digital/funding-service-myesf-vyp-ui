@model PaymentSummaryResultViewModel

@using ViewYourPayments.Web.Shared


<div class="govuk-grid-column-full">
    <table class="govuk-table" id="remittance-table" summary="">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Payment date and amount</th>
                <th scope="col" class="govuk-table__header govuk-table__header--numeric">Link to payment details</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">

            @for (int i = 0; i < @Model.PaymentSummaries.Count(); i++)
            {

                <tr class="govuk-table__row">
                    <td scope="row" class="govuk-table__header">
                        <span class="date">
                            @String.Format("{0:dd MMMM yyyy}", Model.PaymentSummaries[i].PaymentDate)
                        </span><br>
                        <span class="amount govuk-body">
                            @Model.PaymentSummaries[i].PaymentAmount.ToCurrency()
                        </span>
                    </td>
                    <td class="govuk-table__cell govuk-table__cell--numeric govuk-table__cell--bottom">
                        @Html.ActionLink("View your payment details", @Model.PaymentSummaries[i].PaymentIdentifier.ToString(), "PaymentDetails")
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
</div>


